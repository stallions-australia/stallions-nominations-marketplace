<div class="disclosure-panel">
    <h3 class="disclosure-heading">Purchase Summary</h3>

    <dl class="disclosure-table">
        <div class="disclosure-row">
            <dt>Price</dt>
            <dd>@TotalPriceIncGst.ToString("C0", AuCulture) <span class="text-muted text-sm">inc. GST</span></dd>
        </div>
        <div class="disclosure-row disclosure-row--fee">
            <dt>Buyer fee, paid to Stallions Australia</dt>
            <dd>@BuyerFeeIncGst.ToString("C0", AuCulture) <span class="text-muted text-sm">inc. GST</span></dd>
        </div>
        <div class="disclosure-row disclosure-row--balance">
            <dt>Balance payable to the stud</dt>
            <dd>@BalancePayableToStudIncGst.ToString("C0", AuCulture)</dd>
        </div>
    </dl>

    @* All wording below comes from the server (configuration and the stud's listing) — none is hardcoded here. *@
    <div class="disclosure-notice">
        @if (!string.IsNullOrWhiteSpace(BuyerFeeExplanation))
        {
            <p>@BuyerFeeExplanation</p>
        }
        @if (!string.IsNullOrWhiteSpace(BalanceArrangementText))
        {
            <p class="disclosure-notice-gap"><strong>Paying the stud:</strong> @BalanceArrangementText</p>
        }
        @if (!string.IsNullOrWhiteSpace(StudTermsAndConditions))
        {
            <p class="disclosure-notice-gap"><strong>The stud's terms:</strong></p>
            <p class="disclosure-stud-terms">@StudTermsAndConditions</p>
        }
    </div>

    <div class="disclosure-ack">
        <label class="ack-label">
            <input type="checkbox" @onchange="OnAckChanged" />
            <span>I have read and understood the above disclosure.</span>
        </label>
    </div>

    <button class="btn btn-gold btn-full" @onclick="ConfirmClicked"
            disabled="@(!_acknowledged)">
        Confirm purchase
    </button>
</div>

@code {
    [Parameter, EditorRequired] public decimal TotalPriceIncGst { get; set; }
    [Parameter, EditorRequired] public decimal BuyerFeeIncGst { get; set; }
    [Parameter, EditorRequired] public decimal BalancePayableToStudIncGst { get; set; }
    [Parameter, EditorRequired] public string BalanceArrangementText { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string BuyerFeeExplanation { get; set; } = string.Empty;
    [Parameter] public string? StudTermsAndConditions { get; set; }
    [Parameter, EditorRequired] public EventCallback OnConfirmed { get; set; }

    private bool _acknowledged;
    private static readonly System.Globalization.CultureInfo AuCulture =
        System.Globalization.CultureInfo.GetCultureInfo("en-AU");

    private void OnAckChanged(ChangeEventArgs e) =>
        _acknowledged = e.Value is bool b && b;

    private async Task ConfirmClicked() => await OnConfirmed.InvokeAsync();
}
