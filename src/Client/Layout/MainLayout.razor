@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthProvider
@inject UserStateService UserState
@inject TermsApiService TermsApi
@inject UserApiService UserApi
@implements IDisposable

<div class="page-wrapper">
    <NavBar />
    <main class="content-area">
        <ErrorBoundary>
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent Context="ex">
                <div class="container" style="padding-top: var(--space-12)">
                    <div class="error-boundary">
                        <h2>Something went wrong</h2>
                        <p>An unexpected error occurred. Please <a href="/">return to listings</a> or try again.</p>
                    </div>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </main>
    <Footer />
</div>

@if (_termsToAccept is not null)
{
    <TermsAgreementModal Terms="_termsToAccept" OnAccepted="HandleTermsAccepted" />
}

@code {
    protected override async Task OnInitializedAsync()
    {
        AuthProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        await TryLoadUserAsync();
    }

    // Fires when MSAL resolves auth state after the redirect-back-from-login flow,
    // which can happen after OnInitializedAsync has already run.
    private async void OnAuthenticationStateChanged(Task<AuthenticationState> _)
    {
        await TryLoadUserAsync();
        await InvokeAsync(StateHasChanged);
    }

    private TermsDocumentDto? _termsToAccept;

    private async Task TryLoadUserAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            try
            {
                await UserState.LoadAsync();
                await CheckTermsGateAsync();
            }
            catch (Exception)
            {
                // A transient error loading user state should not crash the layout.
                // The user will see the app in unauthenticated mode; they can refresh.
            }
        }
        else
        {
            UserState.Clear();
            _termsToAccept = null;
        }
    }

    private async Task CheckTermsGateAsync()
    {
        _termsToAccept = null;
        if (!UserState.IsBuyer || !UserState.IsVerified) return;

        var current = await TermsApi.GetCurrentAsync();
        if (current is null) return;   // none published → no gate
        if (UserState.NeedsTermsAcceptance(current.Version))
            _termsToAccept = current;
    }

    private async Task HandleTermsAccepted()
    {
        if (_termsToAccept is null) return;
        await UserApi.AcceptTermsAsync(_termsToAccept.Version);
        UserState.MarkTermsAccepted(_termsToAccept.Version);
        _termsToAccept = null;
        StateHasChanged();
    }

    public void Dispose()
    {
        AuthProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
}
