@page "/listings/{Id:guid}"
@inject ListingApiService ListingApi
@inject BidApiService BidApi
@inject NavigationManager Nav
@inject UserStateService UserState
@inject UserApiService UserApi
@inject PaymentsApiService PaymentsApi
@inject AuthenticationStateProvider AuthProvider

<PageTitle>@(_listing?.StallionName ?? "Listing") — Stallions Australia</PageTitle>

@if (_error is not null)
{
    <div class="container" style="padding-top: var(--space-12)">
        <ErrorMessage Message="@_error" OnRetry="Load" />
    </div>
}
else if (_listing is null)
{
    <LoadingSpinner Large="true" />
}
else
{
    <div class="listing-hero">
        <div class="listing-hero-placeholder"></div>
        <div class="listing-hero-overlay"></div>
        <div class="listing-hero-text container">
            <span class="badge badge-auction">@_listing.ListingType</span>
            <h1 class="listing-hero-name">@_listing.StallionName</h1>
            <p class="listing-hero-farm">
                <a href="/studfarms/@_listing.StudFarmId">@_listing.StudFarmName</a>
            </p>
        </div>
    </div>

    <div class="container listing-body">
        <div class="listing-main">

            <div class="listing-price-block">
                @if (GetHighestBid() is decimal highBid)
                {
                    <PriceDisplay Amount="@highBid" Large="true" />
                    <span class="listing-gst-label">inc. GST &middot; current high bid</span>
                }
                else
                {
                    <span class="listing-gst-label">No bids yet</span>
                }
                @if (_listing is AuctionListingDto { IsNoReserve: true })
                {
                    <span class="badge" style="margin-left: var(--space-3)">No reserve</span>
                }
            </div>

            @if (_listing is AuctionListingDto auction)
            {
                <div class="listing-auction-block">
                    <div class="auction-meta">
                        <span class="text-secondary text-sm">Live auction</span>
                        <AuctionTimer ClosesAt="@auction.EndDateTime" />
                        @* The reserve amount is never shown to buyers — only whether it has been met. *@
                        @if (auction.ReserveMet is bool reserveMet)
                        {
                            <span class="@(reserveMet ? "text-success" : "text-muted") text-sm">
                                @(reserveMet ? "Reserve met" : "Reserve not met")
                            </span>
                        }
                        else if (!auction.IsNoReserve)
                        {
                            <span class="text-muted text-sm">Reserve applies</span>
                        }
                    </div>

                    @if (auction.BuyerFeeIncGst is decimal buyerFee)
                    {
                        <div class="buyer-fee-notice">
                            <p class="buyer-fee-amount">
                                Buyer fee: <strong>@FormatPrice(buyerFee)</strong> inc. GST, paid to Stallions Australia
                            </p>
                            @if (!string.IsNullOrWhiteSpace(_disclosure?.BuyerFeeExplanation))
                            {
                                <p class="text-secondary text-sm">@_disclosure.BuyerFeeExplanation</p>
                            }
                        </div>
                    }

                    <AuthorizeView>
                        <Authorized>
                            @* A buyer must have a valid saved card before bidding (the buyer fee is charged to it on a win). *@
                            @if (UserState.IsBuyer && UserState.IsVerified && !_cardChecked)
                            {
                                <p class="text-muted text-sm" role="status" aria-live="polite">Checking your payment card…</p>
                            }
                            else if (UserState.IsBuyer && UserState.IsVerified && _cardCheckFailed)
                            {
                                <p class="text-muted text-sm" role="status" aria-live="polite">We couldn't check your payment card — refresh to try again.</p>
                            }
                            else if (UserState.IsBuyer && UserState.IsVerified && _card is not { IsValid: true })
                            {
                                <a href="/account/card" class="btn btn-gold btn-full">Save a card to bid</a>
                            }
                            else if (UserState.IsBuyer && UserState.IsVerified)
                            {
                                <div class="bid-form">
                                    <p class="bid-form-hint">
                                        Min next bid: <strong>@FormatPrice(GetMinimumNextBid(auction))</strong>
                                    </p>
                                    <div class="bid-form-row">
                                        <input class="form-input" type="number" step="25"
                                               min="@GetMinimumNextBid(auction)"
                                               @bind="_bidAmount" placeholder="Your bid (inc. GST)" />
                                        <button class="btn btn-gold" @onclick="StartBid" disabled="@_bidBusy">
                                            @(_bidBusy ? "Placing…" : "Place bid")
                                        </button>
                                    </div>
                                    @if (_bidError is not null) { <ErrorMessage Message="@_bidError" /> }
                                    @if (_bidSuccess)           { <p class="text-success">&#10003; Bid placed!</p> }
                                </div>
                            }
                            else if (UserState.IsBuyer && UserState.IsPendingVerification)
                            {
                                <div class="pending-verification-notice">
                                    <p><strong>Account verification pending</strong></p>
                                    <p>Your registration is awaiting approval from Stallions Australia. You'll be able to bid once your account has been verified. Please contact <a href="mailto:info@stallionsaustralia.com.au">info@stallionsaustralia.com.au</a> if you have any questions.</p>
                                </div>
                            }
                        </Authorized>
                        <NotAuthorized>
                            <a href="authentication/login" class="btn btn-gold btn-full">Sign in to bid</a>
                        </NotAuthorized>
                    </AuthorizeView>

                    <div class="bid-history">
                        <h3 class="bid-history-title">Bid history</h3>
                        @if (_bidHistory.Count == 0)
                        {
                            <p class="text-muted text-sm">No bids yet.</p>
                        }
                        else
                        {
                            <ol class="bid-history-list">
                                @foreach (var b in _bidHistory)
                                {
                                    <li class="bid-history-row">
                                        <span class="bid-history-bidder">@b.Bidder</span>
                                        <span class="bid-history-amount">@FormatPrice(b.AmountIncGst)</span>
                                        <span class="bid-history-time text-muted text-xs">@b.PlacedAt.ToLocalTime().ToString("d MMM, h:mm tt")</span>
                                    </li>
                                }
                            </ol>
                        }
                    </div>
                </div>
            }


            <div class="listing-enquire">
                <AuthorizeView>
                    <Authorized>
                        <button class="btn btn-outline btn-full" @onclick="OpenEnquiry">
                            Enquire about this listing
                        </button>
                    </Authorized>
                    <NotAuthorized>
                        <a href="authentication/login" class="btn btn-outline btn-full">Sign in to enquire</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>

        <aside class="listing-sidebar">
            <h3>Stallion</h3>
            <a href="/stallions/@_listing.StallionId">View @_listing.StallionName profile &rarr;</a>
        </aside>
    </div>
}

@if (_showBidConfirm)
{
    <BidConfirmationModal BuyerFeeIncGst="@((_listing as AuctionListingDto)?.BuyerFeeIncGst)"
                          BuyerFeeExplanation="@_disclosure?.BuyerFeeExplanation"
                          OnConfirm="ConfirmBidAndPlace" OnCancel="() => _showBidConfirm = false" />
}

@code {
    [Parameter] public Guid Id { get; set; }

    private ListingDto? _listing;
    private string? _error;
    private decimal _bidAmount;
    private bool _bidBusy;
    private string? _bidError;
    private bool _bidSuccess;
    // Updated price after a successful bid
    private decimal? _refreshedHighestBid;
    private List<PublicBidDto> _bidHistory = [];
    private BuyerFeeDisclosureDto? _disclosure;
    private SavedCardDto? _card;
    private bool _cardChecked;
    private bool _cardCheckFailed;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        _error = null;
        _listing = null;
        try
        {
            _listing = await ListingApi.GetByIdAsync(Id);
            if (_listing is AuctionListingDto)
            {
                await LoadBidHistoryAsync();
                await LoadDisclosureAsync();
                await LoadCardAsync();
            }
        }
        catch (ApiException ex) when (ex.StatusCode == 404)
        {
            _error = "This listing could not be found. It may have been removed.";
        }
        catch (ApiException ex)
        {
            _error = ex.StatusCode == 500
                ? $"Failed to load listing: {ex.Message}"
                : "Failed to load listing. Please try again.";
        }
    }

    // Secondary content: a failure here must not hide the listing itself.
    private async Task LoadBidHistoryAsync()
    {
        try { _bidHistory = await ListingApi.GetBidHistoryAsync(Id) ?? []; }
        catch (ApiException) { _bidHistory = []; }
    }

    private async Task LoadDisclosureAsync()
    {
        try { _disclosure = await ListingApi.GetBuyerFeeDisclosureAsync(); }
        catch (ApiException) { _disclosure = null; }
    }

    // Bidding needs a valid saved card. Only signed-in buyers have one to check.
    private async Task LoadCardAsync()
    {
        _card = null;
        _cardCheckFailed = false;
        try
        {
            var auth = await AuthProvider.GetAuthenticationStateAsync();
            if (auth.User.Identity?.IsAuthenticated != true) return;
            // The layout normally loads the user first; make sure, in case this page got there first.
            await UserState.LoadAsync();
            if (UserState.IsBuyer) _card = await PaymentsApi.GetMyCardAsync();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            // A transient failure: don't tell a buyer who has a card to save one.
            _cardCheckFailed = true;
        }
        catch (AccessTokenNotAvailableException)
        {
            // Signed-in session has lapsed — treated as no card; signing in again resolves it.
            _card = null;
        }
        finally
        {
            _cardChecked = true;
        }
    }

    // No starting or asking price is ever shown — only the current high bid, if any.
    private decimal? GetHighestBid() =>
        _refreshedHighestBid ?? (_listing as AuctionListingDto)?.CurrentHighestBidIncGst;

    // First bid: at least the buyer fee (it forms part of the price). Later bids: high bid + increment.
    private decimal GetMinimumNextBid(AuctionListingDto auction) =>
        GetHighestBid() is decimal high
            ? high + auction.MinimumBidIncrement
            : auction.BuyerFeeIncGst ?? auction.MinimumBidIncrement;

    private static string FormatPrice(decimal amount) =>
        amount.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-AU"));

    private bool _showBidConfirm;

    // Called by the "Place bid" button — gates on the first-bid confirmation.
    private void StartBid()
    {
        _bidError = null;
        if (UserState.SuppressBidConfirmation)
        {
            _ = DoPlaceBidAsync();
        }
        else
        {
            _showBidConfirm = true;
        }
    }

    private async Task ConfirmBidAndPlace(bool dontShowAgain)
    {
        _showBidConfirm = false;
        if (dontShowAgain)
        {
            try
            {
                await UserApi.SuppressBidConfirmationAsync();
                UserState.MarkBidConfirmationSuppressed();
            }
            catch { /* non-fatal — proceed with the bid regardless */ }
        }
        await DoPlaceBidAsync();
    }

    private async Task DoPlaceBidAsync()
    {
        _bidError = null;
        _bidSuccess = false;
        _bidBusy = true;
        try
        {
            await BidApi.PlaceBidAsync(Id, new PlaceBidRequest { AmountIncGst = _bidAmount });
            _bidSuccess = true;
            var refreshed = await BidApi.GetCurrentBidAsync(Id);
            _refreshedHighestBid = refreshed?.HighestBidIncGst;
            await LoadBidHistoryAsync();
        }
        catch (ApiException ex)
        {
            if (ex.Message.Contains("Terms & Conditions"))
            {
                // Server rejected because a newer T&C needs acceptance. Refresh state so the
                // layout gate re-prompts; tell the buyer what to do.
                _bidError = "Please accept the latest Terms & Conditions, then try again.";
                await UserState.LoadAsync();
            }
            else
            {
                _bidError = ex.Message;
            }
        }
        finally
        {
            _bidBusy = false;
        }
    }

    private void OpenEnquiry() => Nav.NavigateTo("/enquiries");
}
