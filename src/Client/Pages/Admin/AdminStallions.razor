@page "/admin/stallions"
@layout AdminLayout
@attribute [Authorize]
@inject AdminApiService AdminApi
@inject SubscriptionApiService SubscriptionApi
@inject PlatformSettingsApiService SettingsApi
@inject NavigationManager Nav
@inject UserStateService UserState
@implements IDisposable

<PageTitle>My Stallions — Stallions Australia</PageTitle>

<div class="admin-page-header">
    <h1>My Stallions</h1>
    @* Free-form add is hidden when the farm is directory-managed *@
    @if (_authorized != null && !_authorized.IsLinked)
    {
        <a href="/admin/stallions/new" class="btn btn-primary">+ Add Stallion</a>
    }
</div>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_error is not null)
{
    <ErrorMessage Message="@_error" OnRetry="Load" />
}
else if (_authorized != null)
{
    @* ── Farm not linked ──────────────────────────────────────────────────── *@
    @if (!_authorized.IsLinked)
    {
        <div class="alert alert-warning">
            <strong>Your stud farm hasn't been linked to the stallion directory yet.</strong>
            Please contact Stallions Australia to have your farm linked.
            Once linked, your authorized stallions will appear here.
        </div>
    }

    @* ── Your stable ─────────────────────────────────────────────────────── *@
    <h2 style="font-size:var(--font-size-lg);margin:var(--space-6) 0 var(--space-4)">Your Stable</h2>

    @if (_stallions.Count == 0)
    {
        <EmptyState Message="You haven't added any stallions yet." Icon="🐴" />
    }
    else
    {
        @if (_confirmingPayment)
        {
            <p class="listing-fee-payment-status">Confirming your listing-fee payment…</p>
        }
        @if (_paymentNotice is not null)
        {
            <p class="listing-fee-payment-status">@_paymentNotice</p>
        }
        @if (_activateError is not null)
        {
            <ErrorMessage Message="@_activateError" />
        }
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Year of Birth</th>
                    <th>Colour</th>
                    <th>Status</th>
                    <th>Listing fee@(_openSeason is null ? "" : $" ({_openSeason.Name})")</th>
                    <th>Total Listings</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in _stallions)
                {
                    <tr>
                        <td><strong>@s.Name</strong></td>
                        <td>@(s.YearOfBirth?.ToString() ?? "—")</td>
                        <td>@(s.Colour ?? "—")</td>
                        <td>
                            <span class="badge @(s.IsActive ? "badge-active" : "badge-cancelled")">
                                @(s.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>
                            @if (_openSeason is null)
                            {
                                <span class="text-muted text-sm">No season open</span>
                            }
                            else
                            {
                                var status = SubscriptionStatusFor(s.Id);
                                <span class="badge badge-sub-@status.ToLowerInvariant()">@status</span>
                                @if (status is not ("Paid" or "Waived"))
                                {
                                    var fee = FeeFor(s.Id);
                                    @if (fee is decimal amount && amount > 0)
                                    {
                                        <div>
                                            <button class="btn btn-sm btn-gold" disabled="@(_activating is not null)"
                                                    @onclick="() => ActivateAsync(s.Id)">
                                                @(_activating == s.Id ? "Opening…" : $"Activate for {_openSeason.Name} — {amount.ToString("C0", AuCulture)}")
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="listing-fee-notice">
                                            Listing fee required. Contact Stallions Australia to activate.
                                        </div>
                                    }
                                }
                            }
                        </td>
                        <td>@s.TotalListingCount</td>
                        <td class="admin-table-actions">
                            <a href="/admin/stallions/@s.Id" class="btn btn-sm btn-secondary">Edit</a>
                            <a href="/admin/listings/new?stallionId=@s.Id" class="btn btn-sm btn-outline">+ Listing</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @* ── Available to add (directory-linked farms only) ───────────────────── *@
    @if (_authorized.IsLinked)
    {
        <h2 style="font-size:var(--font-size-lg);margin:var(--space-8) 0 var(--space-4)">
            Available to Add
        </h2>

        @if (!_authorized.Available.Any())
        {
            <p style="color:var(--text-muted)">
                All stallions in your stud directory have been added to your stable.
            </p>
        }
        else
        {
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Year</th>
                        <th>Colour</th>
                        <th>Sire</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in _authorized.Available)
                    {
                        <tr>
                            <td><strong>@d.Name</strong></td>
                            <td>@d.YearOfBirth</td>
                            <td>@(d.Colour ?? "—")</td>
                            <td>@("—")</td>
                            <td class="admin-table-actions">
                                <button class="btn btn-sm btn-primary"
                                        disabled="@_adding.Contains(d.Id)"
                                        @onclick="() => AddAsync(d.Id)">
                                    @(_adding.Contains(d.Id) ? "Adding…" : "Add to Stable")
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        @if (_addError != null)
        {
            <div class="alert alert-error" style="margin-top:var(--space-4)">@_addError</div>
        }

        @* ── Missing a stallion? mailto ────────────────────────────────── *@
        <div style="margin-top:var(--space-6)">
            <a href="@_missingMailto" class="btn btn-outline btn-sm">
                Missing a stallion?
            </a>
            <p style="font-size:var(--font-size-sm);color:var(--text-muted);margin-top:var(--space-2)">
                If a stallion is missing from the list above, contact Stallions Australia
                and we'll add it to the directory.
            </p>
        </div>
    }
}

@code {
    private List<StallionSummaryDto> _stallions = [];
    private AuthorizedStallionsDto? _authorized;
    private SeasonDto? _openSeason;
    private List<SubscriptionDto> _subscriptions = [];
    private readonly HashSet<Guid> _adding = [];
    private bool _loading = true;
    private string? _error;
    private string? _addError;
    private string _missingMailto = string.Empty;
    private decimal? _standardFee;
    private Guid? _activating;
    private string? _activateError;
    private bool _confirmingPayment;
    private string? _paymentNotice;
    private readonly CancellationTokenSource _cts = new();

    private static readonly System.Globalization.CultureInfo AuCulture =
        System.Globalization.CultureInfo.GetCultureInfo("en-AU");

    /// <summary>How often to re-check after returning from the payment page (tests shorten it).</summary>
    [Parameter] public TimeSpan PollInterval { get; set; } = TimeSpan.FromSeconds(2);

    protected override async Task OnInitializedAsync()
    {
        await UserState.LoadAsync();
        if (!UserState.IsStudFarmAdmin) { Nav.NavigateTo("/", replace: true); return; }
        await Load();

        var query = new Uri(Nav.Uri).Query;
        if (query.Contains("payment=cancelled"))
            _paymentNotice = "Payment not completed — the listing fee is still due.";
        else if (_error is null && _openSeason is not null && query.Contains("payment=success"))
            await WaitForPaymentAsync();
    }

    // The provider's webhook marks the fee Paid; re-check for up to ~60 s until one more stallion
    // is Paid for the open season than when the page loaded.
    private async Task WaitForPaymentAsync()
    {
        int PaidCount() => _subscriptions.Count(x => x.Status == "Paid" && x.SeasonId == _openSeason?.Id);
        var paidBefore = PaidCount();
        _confirmingPayment = true;
        StateHasChanged();
        try
        {
            for (var i = 0; i < 30 && PaidCount() == paidBefore; i++)
            {
                await Task.Delay(PollInterval, _cts.Token);
                try { _subscriptions = await SubscriptionApi.GetMineAsync() ?? []; }
                catch (ApiException) { /* keep the last known list and try again */ }
                StateHasChanged();
            }
        }
        catch (TaskCanceledException) { return; } // left the page
        _confirmingPayment = false;
        if (PaidCount() == paidBefore)
            _paymentNotice = "Your payment is still being confirmed — refresh this page shortly.";
    }

    private async Task Load()
    {
        _loading = true; _error = null; _addError = null;
        try
        {
            _stallions = await AdminApi.GetMyStallionsAsync();
            _authorized = await AdminApi.GetAuthorizedStallionsAsync();
            _openSeason = (await AdminApi.GetSeasonsAsync() ?? []).FirstOrDefault(s => s.IsOpen);
            _subscriptions = await SubscriptionApi.GetMineAsync() ?? [];
            // Shown on the Activate button; without it the stud is asked to contact Stallions Australia.
            try { _standardFee = (await SettingsApi.GetAsync()).StandardListingFeeIncGst; }
            catch (ApiException) { _standardFee = null; }

            if (_authorized != null)
            {
                var subject = Uri.EscapeDataString("Missing Stallion – " + _authorized.FarmName);
                var body = Uri.EscapeDataString("Hi,\n\nI’m missing the following stallion from my Available to Add list:\n\nStallion name: \nYear of birth: \n\nPlease add it to the directory.\n\nThanks");
                _missingMailto = "mailto:nominations@stallionsaustralia.com.au" +
                    "?subject=" + subject +
                    "&body=" + body;
            }
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    // Paid / Waived / Pending for the open season, or None when Staff haven't set one up.
    private string SubscriptionStatusFor(Guid stallionId) =>
        _subscriptions.FirstOrDefault(x => x.StallionId == stallionId && x.SeasonId == _openSeason?.Id)?.Status
        ?? "None";

    // A Pending subscription keeps its own amount (e.g. a Staff discount); otherwise the standard fee.
    private decimal? FeeFor(Guid stallionId) =>
        _subscriptions.FirstOrDefault(x => x.StallionId == stallionId && x.SeasonId == _openSeason?.Id)?.FeeIncGst
        ?? _standardFee;

    private async Task ActivateAsync(Guid stallionId)
    {
        _activating = stallionId; _activateError = null;
        // Stripe returns an absolute URL, the dev fake a relative one — both need a full page load.
        try { Nav.NavigateTo(await SubscriptionApi.ActivateAsync(stallionId), forceLoad: true); }
        catch (ApiException ex) { _activateError = ex.Message; }
        finally { _activating = null; }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    private async Task AddAsync(Guid directoryId)
    {
        _adding.Add(directoryId);
        _addError = null;
        try
        {
            await AdminApi.AddFromDirectoryAsync(directoryId);
            await Load();
        }
        catch (ApiException ex)
        {
            _addError = ex.Message;
        }
        finally
        {
            _adding.Remove(directoryId);
        }
    }
}
